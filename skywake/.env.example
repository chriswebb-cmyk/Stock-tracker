# Skywake environment template. Copy to `.env.local` (web) or set via
# `wrangler secret put` (workers) — never commit real values.

# --- Web (web/.env.local) ---------------------------------------------------

# Cesium ion access token. Required for Cesium World Terrain + Bing imagery.
# Get one at https://ion.cesium.com → Access Tokens.
VITE_CESIUM_ION_TOKEN=

# Optional override of the API base URL. Default is /api (proxied by Vite).
VITE_API_URL=

# --- Workers (workers/*/.dev.vars) -----------------------------------------

# JWT signing key. Random 32+ bytes, base64 or hex. Rotate to invalidate
# all outstanding sessions.
JWT_SIGNING_KEY=

# R2 signing credentials. Generate at Cloudflare dashboard →
#   R2 → Manage R2 API Tokens → Create API token (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skywake-flights
