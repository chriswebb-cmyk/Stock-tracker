# Alpha Vantage REST API key.
# Get one at https://www.alphavantage.co/support/#api-key.
# In production this lives in Cloudflare Worker secrets and Netlify env vars,
# never in committed code.
ALPHAVANTAGE_API_KEY=your_key_here

# Discord webhook URL used for high-confidence signal alerts.
# Create one in Server Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=

# Public URL of the read API worker, used by the frontend.
VITE_API_BASE_URL=http://localhost:8788
