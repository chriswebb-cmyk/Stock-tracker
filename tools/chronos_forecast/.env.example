# Copy to .env and fill in. .env is gitignored.

STOCK_TRACKER_API=https://stock-tracker-api.chris-stocks.workers.dev

# Bearer token. Reuses the same KRONOS_API_KEY worker secret since both
# foundation models are operated by the same local user.
KRONOS_API_KEY=replace-with-the-same-string-you-used-for-kronos

# Chronos checkpoint. Bolt variants are ~250x faster than the original
# T5 models. On 8GB M1, stick to tiny or mini.
#   amazon/chronos-bolt-tiny    (~9M params, fastest)
#   amazon/chronos-bolt-mini    (~21M params)
#   amazon/chronos-bolt-small   (~48M params)
#   amazon/chronos-bolt-base    (~205M params, tight on 8GB)
CHRONOS_MODEL=amazon/chronos-bolt-tiny

# Forecast knobs.
CHRONOS_PRED_LEN=5          # business days ahead
CHRONOS_LOOKBACK=480        # daily bars of history fed to the model
CHRONOS_SAMPLE_COUNT=20     # forecast paths for P10/P50/P90 (cheap with Bolt)

# 'mps' on Apple Silicon, 'cuda' if you have an NVIDIA GPU, 'cpu' otherwise.
CHRONOS_DEVICE=mps
