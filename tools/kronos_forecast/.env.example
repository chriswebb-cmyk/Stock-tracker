# Copy to .env and fill in. .env is gitignored.

# URL of your stock-tracker API worker.
STOCK_TRACKER_API=https://stock-tracker-api.chris-stocks.workers.dev

# Bearer token. Must match the worker's KRONOS_API_KEY secret (set with
# `npx wrangler secret put KRONOS_API_KEY` inside workers/api/).
KRONOS_API_KEY=replace-with-a-long-random-string

# Path to the cloned Kronos repo. The script imports model classes from
# its model/ directory. If KRONOS_REPO is unset, defaults to ~/Kronos.
KRONOS_REPO=~/Kronos

# Which checkpoint to load. Options on 8GB M1:
#   NeoQuasar/Kronos-mini    (4.1M params, 2048 ctx) — safest
#   NeoQuasar/Kronos-small   (24.7M params, 512 ctx)
#   NeoQuasar/Kronos-base    (102M params, 512 ctx) — tight on 8GB
KRONOS_MODEL=NeoQuasar/Kronos-mini
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base

# Forecast knobs.
KRONOS_PRED_LEN=5         # business days ahead
KRONOS_LOOKBACK=480       # daily bars of history fed to the model
KRONOS_SAMPLE_COUNT=5     # forecast paths averaged per symbol
KRONOS_TEMPERATURE=1.0
KRONOS_TOP_P=0.9

# 'mps' on Apple Silicon, 'cuda' if you have an NVIDIA GPU, 'cpu' otherwise.
KRONOS_DEVICE=mps
